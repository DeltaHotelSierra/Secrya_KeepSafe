# Secrya KeepSafe Backend Configuration

# Flask Environment
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=False

# Google OAuth Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Backend Server
BACKEND_HOST=localhost
BACKEND_PORT=5000
BACKEND_DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/secrya_backend.log

# CORS Settings
CORS_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Secrya Settings
SECRYA_REPORTS_DIR=./reports
SECRYA_ENABLE_REPORT_SAVING=True
